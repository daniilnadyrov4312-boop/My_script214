/**
 * ОПРОСНИК ДЛЯ ИССЛЕДОВАНИЯ СОЦИАЛЬНОГО ВЗАИМОДЕЙСТВИЯ У СТУДЕНТОВ
 *
 * КАК ИСПОЛЬЗОВАТЬ:
 * 1. Откройте https://script.google.com и создайте новый проект
 * 2. Вставьте весь этот код в редактор
 * 3. Нажмите «Выполнить» (кнопка ▶) для функции createSurveyForm
 * 4. При первом запуске выдайте разрешение на доступ к Google Forms
 * 5. В разделе «Журнал выполнения» появятся ссылки на форму
 */

function createSurveyForm() {

  // ---------- Создание формы ----------
  var form = FormApp.create('Опросник для исследования социального взаимодействия');
  form.setDescription(
    'Здравствуйте! Приглашаю вас принять участие в исследовании, посвящённом изучению особенностей ' +
    'социального взаимодействия у студентов. Опрос анонимный, результаты будут использованы исключительно ' +
    'в научных целях в рамках курсовой работы. Заполнение займёт около 20–25 минут. Пожалуйста, отвечайте ' +
    'искренне — здесь нет правильных и неправильных ответов. Спасибо!'
  );
  form.setIsQuiz(false);
  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setShuffleQuestions(false);

  // =====================================================================
  // БЛОК 0. СОЦИАЛЬНО-ДЕМОГРАФИЧЕСКИЕ ДАННЫЕ
  // =====================================================================
  form.addSectionHeaderItem()
    .setTitle('БЛОК 0. СОЦИАЛЬНО-ДЕМОГРАФИЧЕСКИЕ ДАННЫЕ');

  form.addTextItem()
    .setTitle('1. Ваш возраст (полных лет)')
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('2. Ваш пол')
    .setChoiceValues(['М', 'Ж'])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('3. Курс обучения')
    .setChoiceValues(['1', '2', '3', '4', 'Магистратура'])
    .setRequired(true);

  form.addTextItem()
    .setTitle('4. Направление подготовки / специальность')
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('5. Форма обучения')
    .setChoiceValues(['Очная', 'Очно-заочная', 'Заочная'])
    .setRequired(true);

  // =====================================================================
  // БЛОК 1. ТЕСТ СОЦИАЛЬНОГО ИНТЕЛЛЕКТА ДЖ. ГИЛФОРДА (СУБТЕСТ №4)
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('БЛОК 1. ТЕСТ СОЦИАЛЬНОГО ИНТЕЛЛЕКТА ДЖ. ГИЛФОРДА (СУБТЕСТ №4 — «Истории с дополнением»)');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'В каждом задании вам предлагается описание ситуации. Нужно выбрать из четырёх вариантов тот, ' +
      'который логично продолжает или дополняет историю, исходя из понимания поведения и намерений людей.'
    );

  var guilfordQuestions = [
    {
      text: 'Молодой человек разговаривает с девушкой на остановке. Девушка смотрит на часы, отступает на шаг, оглядывается по сторонам. Что произойдёт дальше вероятнее всего?',
      options: ['а) Девушка пригласит его на свидание', 'б) Девушка попрощается и уйдёт', 'в) Они продолжат долгий разговор', 'г) Девушка обнимет его']
    },
    {
      text: 'На совещании коллега резко перебивает начальника и громко высказывает несогласие. Начальник молчит, сжав губы, и записывает что-то в блокнот. Что вероятнее всего последует?',
      options: ['а) Начальник публично похвалит коллегу', 'б) Начальник проигнорирует инцидент навсегда', 'в) Начальник позже вызовет коллегу для серьёзного разговора', 'г) Коллеги устроят праздник']
    },
    {
      text: 'Ребёнок прячет руки за спину и опускает глаза, когда мама спрашивает, кто разбил вазу. Что это значит?',
      options: ['а) Ребёнок не слышал вопроса', 'б) Ребёнок чувствует вину и, вероятно, причастен', 'в) Ребёнок хочет обнять маму', 'г) Ребёнок устал']
    },
    {
      text: 'Двое друзей договорились встретиться. Один опаздывает на час, не отвечает на звонки. Когда наконец приходит, второй друг скрещивает руки и отворачивается. Что произойдёт?',
      options: ['а) Друзья сразу пойдут веселиться', 'б) Опоздавший должен будет извиниться и объясниться', 'в) Второй друг предложит подарок', 'г) Они разойдутся молча навсегда']
    },
    {
      text: 'На собеседовании кандидат постоянно ёрзает, избегает зрительного контакта, говорит очень тихо. Что подумает HR-специалист?',
      options: ['а) Кандидат уверен в себе', 'б) Кандидат, вероятно, волнуется или не уверен', 'в) Кандидат агрессивен', 'г) Кандидат опытен']
    },
    {
      text: 'Преподаватель раздаёт работы и, подходя к одному студенту, улыбается и кивает. Что вероятнее всего написано в работе?',
      options: ['а) Работа провалена', 'б) Работа выполнена хорошо', 'в) Работа не сдана', 'г) Работа списана']
    },
    {
      text: 'Девушка плачет, подруга молча обнимает её и не задаёт вопросов. Что демонстрирует подруга?',
      options: ['а) Безразличие', 'б) Эмпатию и поддержку', 'в) Раздражение', 'г) Любопытство']
    },
    {
      text: 'В магазине покупатель повышает голос на кассира. Кассир делает глубокий вдох и спокойно отвечает. Что демонстрирует кассир?',
      options: ['а) Согласие с покупателем', 'б) Профессиональную выдержку', 'в) Страх', 'г) Агрессию']
    },
    {
      text: 'На вечеринке человек стоит в стороне, держит телефон, не подходит к группам людей. Что вероятнее всего?',
      options: ['а) Он социально активен', 'б) Он чувствует себя некомфортно или стесняется', 'в) Он ведущий вечеринки', 'г) Он зол на всех']
    },
    {
      text: 'Начальник входит в кабинет с улыбкой, держа в руках папку, и говорит: «У меня для вас новости». Сотрудники переглядываются. Что они, скорее всего, ожидают?',
      options: ['а) Что-то значимое (повышение, премию или важное изменение)', 'б) Что начальник уйдёт', 'в) Что будет обед', 'г) Ничего особенного']
    },
    {
      text: 'Парень дарит девушке цветы, но она принимает их сухо и кладёт на стол не глядя. Что это означает?',
      options: ['а) Девушка в восторге', 'б) Между ними напряжение или конфликт', 'в) Девушка не заметила цветы', 'г) Это её день рождения']
    },
    {
      text: 'Два коллеги шепчутся и замолкают, когда в комнату входит третий. Что вероятнее всего?',
      options: ['а) Они обсуждали этого третьего', 'б) Они говорили о погоде', 'в) Они поют', 'г) Они не заметили его']
    },
    {
      text: 'Студент задаёт преподавателю много уточняющих вопросов после лекции. Что это говорит о студенте?',
      options: ['а) Он не слушал', 'б) Он заинтересован темой или готовится к экзамену', 'в) Он злится', 'г) Он хочет уйти']
    },
    {
      text: 'Мама строго смотрит на ребёнка, скрестив руки, и молчит. Ребёнок опускает голову. Что произошло до этого?',
      options: ['а) Ребёнок получил подарок', 'б) Ребёнок сделал что-то не так', 'в) Мама рассказала шутку', 'г) Они только встретились']
    }
  ];

  for (var i = 0; i < guilfordQuestions.length; i++) {
    form.addMultipleChoiceItem()
      .setTitle('Задание ' + (i + 1) + '. ' + guilfordQuestions[i].text)
      .setChoiceValues(guilfordQuestions[i].options)
      .setRequired(true);
  }

  // =====================================================================
  // БЛОК 2. ШКАЛА СОЦИАЛЬНОЙ ТРЕВОЖНОСТИ ЛЕЙБОВИЦА (LSAS)
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('БЛОК 2. ШКАЛА СОЦИАЛЬНОЙ ТРЕВОЖНОСТИ ЛЕЙБОВИЦА (LSAS)');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'Оцените каждую ситуацию по двум параметрам:\n\n' +
      'СТРАХ / ТРЕВОГА:\n' +
      '0 — нет  |  1 — слабая  |  2 — умеренная  |  3 — сильная\n\n' +
      'ИЗБЕГАНИЕ:\n' +
      '0 — никогда (0%)  |  1 — иногда (1–33%)  |  2 — часто (33–67%)  |  3 — обычно (67–100%)'
    );

  var lsasItems = [
    'Разговор по телефону в общественном месте',
    'Участие в небольших группах',
    'Приём пищи в общественных местах',
    'Питьё в компании в общественных местах',
    'Разговор с авторитетным лицом',
    'Выступление или игра перед аудиторией',
    'Поход на вечеринку',
    'Работа под наблюдением',
    'Письмо под наблюдением',
    'Звонок незнакомому человеку',
    'Разговор с незнакомыми людьми',
    'Встреча с незнакомыми людьми',
    'Использование общественного туалета',
    'Вход в комнату, когда другие уже сидят',
    'Нахождение в центре внимания',
    'Выступление на собрании',
    'Сдача теста или экзамена',
    'Выражение несогласия с незнакомым человеком',
    'Поддержание зрительного контакта с малознакомым человеком',
    'Доклад перед группой',
    'Попытка познакомиться с целью романтических отношений',
    'Возврат товара в магазин',
    'Организация вечеринки',
    'Сопротивление давлению продавца'
  ];

  var fearOptions   = ['0 — нет', '1 — слабая', '2 — умеренная', '3 — сильная'];
  var avoidOptions  = ['0 — никогда (0%)', '1 — иногда (1–33%)', '2 — часто (33–67%)', '3 — обычно (67–100%)'];

  for (var j = 0; j < lsasItems.length; j++) {
    var num = j + 1;

    form.addMultipleChoiceItem()
      .setTitle('Ситуация ' + num + '. ' + lsasItems[j] + '  —  СТРАХ / ТРЕВОГА')
      .setChoiceValues(fearOptions)
      .setRequired(true);

    form.addMultipleChoiceItem()
      .setTitle('Ситуация ' + num + '. ' + lsasItems[j] + '  —  ИЗБЕГАНИЕ')
      .setChoiceValues(avoidOptions)
      .setRequired(true);
  }

  // =====================================================================
  // БЛОК 3. ОПРОСНИК СТиСФ (САГАЛАКОВА, ТРУЕВЦЕВ)
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('БЛОК 3. ОПРОСНИК СОЦИАЛЬНОЙ ТРЕВОГИ И СОЦИОФОБИИ (СТиСФ)\nО.А. Сагалакова, Д.В. Труевцев — краткая форма');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'Оцените, насколько каждое утверждение соответствует вашему обычному состоянию и поведению.\n\n' +
      '0 — совсем не про меня\n' +
      '1 — скорее не про меня\n' +
      '2 — скорее про меня\n' +
      '3 — полностью про меня'
    );

  var sagalakovaItems = [
    'Я боюсь, что другие заметят мою тревогу или волнение',
    'Мне трудно начать разговор с малознакомым человеком',
    'Я часто прокручиваю в голове неудачные ситуации общения',
    'Я избегаю ситуаций, где могу оказаться в центре внимания',
    'Меня беспокоит, что обо мне подумают другие',
    'Я боюсь публичных выступлений',
    'В присутствии других мне трудно сосредоточиться на задаче',
    'Я заранее тревожусь о предстоящих социальных событиях',
    'Я чувствую себя скованно при общении с противоположным полом',
    'Мне сложно отстаивать своё мнение в группе',
    'Я опасаюсь критики и насмешек',
    'После общения я часто анализирую, что сделал не так',
    'Мне трудно обращаться с просьбами к посторонним',
    'Я стараюсь не привлекать к себе внимание в общественных местах',
    'Я боюсь показаться глупым или смешным',
    'В новых компаниях я чувствую напряжение',
    'Я избегаю конфликтов даже когда нужно отстоять свою позицию'
  ];

  var sagalakovaOptions = [
    '0 — совсем не про меня',
    '1 — скорее не про меня',
    '2 — скорее про меня',
    '3 — полностью про меня'
  ];

  for (var k = 0; k < sagalakovaItems.length; k++) {
    form.addMultipleChoiceItem()
      .setTitle((k + 1) + '. ' + sagalakovaItems[k])
      .setChoiceValues(sagalakovaOptions)
      .setRequired(true);
  }

  // =====================================================================
  // ФИНАЛЬНОЕ СООБЩЕНИЕ И ВЫВОД ССЫЛОК
  // =====================================================================
  form.setConfirmationMessage('Спасибо за участие! Ваши ответы внесли важный вклад в исследование.');

  Logger.log('=== ФОРМА СОЗДАНА ===');
  Logger.log('Ссылка для редактирования: ' + form.getEditUrl());
  Logger.log('Ссылка для прохождения:    ' + form.getPublishedUrl());
}
