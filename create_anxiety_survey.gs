 * ИССЛЕДОВАНИЕ ТРЕВОЖНОСТИ У СТУДЕНТОВ
 * Опросник Спилбергера–Ханина (ШТАИ)
 *
 * КАК ИСПОЛЬЗОВАТЬ:
 * 1. Откройте https://script.google.com → Создать новый проект
 * 2. Вставьте весь этот код в редактор
 * 3. Нажмите ▶ (Выполнить) → функция createAnxietySurvey
 * 4. Выдайте разрешение на доступ к Google Forms
 * 5. Ссылки появятся в «Журнале выполнения»
 */

function createAnxietySurvey() {

  // ===== СОЗДАНИЕ ФОРМЫ =====
  var form = FormApp.create('Исследование тревожности у студентов');
  form.setDescription(
    'Опрос анонимный, проводится в учебных целях. ' +
    'Здесь нет правильных и неправильных ответов. ' +
    'Отвечайте искренне, долго над вопросами не задумывайтесь. ' +
    'Спасибо за участие!'
  );
  form.setIsQuiz(false);
  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setShuffleQuestions(false);

  // =====================================================================
  // РАЗДЕЛ 1. ОБЩИЕ ДАННЫЕ
  // =====================================================================
  form.addSectionHeaderItem()
    .setTitle('Раздел 1. Общие данные');

  form.addMultipleChoiceItem()
    .setTitle('Ваш пол')
    .setChoiceValues(['Мужской', 'Женский'])
    .setRequired(true);

  form.addTextItem()
    .setTitle('Ваш возраст')
    .setRequired(true);

  form.addTextItem()
    .setTitle('Курс обучения')
    .setRequired(true);

  // =====================================================================
  // РАЗДЕЛ 2. СИТУАТИВНАЯ ТРЕВОЖНОСТЬ (как вы себя чувствуете В ДАННЫЙ МОМЕНТ)
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('Раздел 2. Как вы себя чувствуете В ДАННЫЙ МОМЕНТ');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'Прочитайте каждое утверждение и выберите цифру, соответствующую тому, как вы чувствуете себя прямо сейчас.\n\n' +
      '1 — нет, это совсем не так\n' +
      '2 — пожалуй, так\n' +
      '3 — верно\n' +
      '4 — совершенно верно'
    );

  var stateItems = [
    'Я спокоен',
    'Мне ничто не угрожает',
    'Я нахожусь в напряжении',
    'Я внутренне скован',
    'Я чувствую себя свободно',
    'Я расстроен',
    'Меня волнуют возможные неудачи',
    'Я ощущаю душевный покой',
    'Я встревожен',
    'Я испытываю чувство внутреннего удовлетворения',
    'Я уверен в себе',
    'Я нервничаю',
    'Я не нахожу себе места',
    'Я взвинчен',
    'Я не чувствую скованности, напряжения',
    'Я доволен',
    'Я озабочен',
    'Я слишком возбуждён и мне не по себе',
    'Мне радостно',
    'Мне приятно'
  ];

  for (var i = 0; i < stateItems.length; i++) {
    form.addScaleItem()
      .setTitle((i + 1) + '. ' + stateItems[i])
      .setBounds(1, 4)
      .setLabels('Нет, это не так', 'Совершенно верно')
      .setRequired(true);
  }

  // =====================================================================
  // РАЗДЕЛ 3. ЛИЧНОСТНАЯ ТРЕВОЖНОСТЬ (как вы себя чувствуете ОБЫЧНО)
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('Раздел 3. Как вы себя чувствуете ОБЫЧНО');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'Прочитайте каждое утверждение и выберите цифру, соответствующую тому, как вы чувствуете себя обычно.\n\n' +
      '1 — почти никогда\n' +
      '2 — иногда\n' +
      '3 — часто\n' +
      '4 — почти всегда'
    );

  var traitItems = [
    'У меня бывает приподнятое настроение',
    'Я бываю раздражительным',
    'Я легко могу расстроиться',
    'Я хотел бы быть таким же удачливым, как и другие',
    'Я сильно переживаю неприятности и долго не могу о них забыть',
    'Я чувствую прилив сил и желание работать',
    'Я спокоен, хладнокровен и собран',
    'Меня тревожат возможные трудности',
    'Я слишком переживаю из-за пустяков',
    'Я бываю вполне счастлив',
    'Я всё принимаю близко к сердцу',
    'Мне не хватает уверенности в себе',
    'Я чувствую себя беззащитным',
    'Я стараюсь избегать критических ситуаций и трудностей',
    'У меня бывает хандра',
    'Я бываю доволен',
    'Всякие пустяки отвлекают и волнуют меня',
    'Бывает, что я чувствую себя неудачником',
    'Я уравновешенный человек',
    'Меня охватывает беспокойство, когда я думаю о своих делах и заботах'
  ];

  for (var j = 0; j < traitItems.length; j++) {
    form.addScaleItem()
      .setTitle((j + 1) + '. ' + traitItems[j])
      .setBounds(1, 4)
      .setLabels('Почти никогда', 'Почти всегда')
      .setRequired(true);
  }

  // =====================================================================
  // ФИНАЛЬНОЕ СООБЩЕНИЕ И ССЫЛКИ
  // =====================================================================
  form.setConfirmationMessage('Спасибо за участие! Ваши ответы внесли важный вклад в исследование.');

  Logger.log('=== ФОРМА СОЗДАНА ===');
  Logger.log('Редактирование: ' + form.getEditUrl());
  Logger.log('Для респондентов: ' + form.getPublishedUrl());
}
