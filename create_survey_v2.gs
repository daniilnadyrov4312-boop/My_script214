/**
 * ОПРОСНИК: СОЦИАЛЬНЫЙ ИНТЕЛЛЕКТ И СОЦИАЛЬНАЯ ТРЕВОЖНОСТЬ
 *
 * КАК ИСПОЛЬЗОВАТЬ:
 * 1. Откройте https://script.google.com → Создать новый проект
 * 2. Вставьте весь код в редактор
 * 3. Нажмите ▶ (Выполнить) → функция createSurveyForm
 * 4. Выдайте разрешение на доступ к Google Forms
 * 5. Ссылки появятся в «Журнале выполнения»
 */

function createSurveyForm() {

  // ===== СОЗДАНИЕ ФОРМЫ =====
  var form = FormApp.create('Опросник: социальный интеллект и социальная тревожность');
  form.setDescription(
    'Здравствуйте! Приглашаю вас принять участие в исследовании, посвящённом изучению особенностей ' +
    'социального взаимодействия у студентов. Опрос анонимный, результаты будут использованы ' +
    'исключительно в научных целях в рамках курсовой работы. Заполнение займёт около 15–20 минут. ' +
    'Пожалуйста, отвечайте искренне — здесь нет правильных и неправильных ответов. Спасибо за участие!'
  );
  form.setIsQuiz(false);
  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setShuffleQuestions(false);

  // =====================================================================
  // РАЗДЕЛ 0. СОЦИАЛЬНО-ДЕМОГРАФИЧЕСКИЕ ДАННЫЕ
  // =====================================================================
  form.addSectionHeaderItem()
    .setTitle('РАЗДЕЛ 0. СОЦИАЛЬНО-ДЕМОГРАФИЧЕСКИЕ ДАННЫЕ');

  form.addTextItem()
    .setTitle('1. Ваш возраст (полных лет)')
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('2. Ваш пол')
    .setChoiceValues(['Мужской', 'Женский'])
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('3. Курс обучения')
    .setChoiceValues(['1', '2', '3', '4', 'Магистратура'])
    .setRequired(true);

  form.addTextItem()
    .setTitle('4. Направление подготовки / специальность')
    .setRequired(true);

  form.addMultipleChoiceItem()
    .setTitle('5. Форма обучения')
    .setChoiceValues(['Очная', 'Очно-заочная', 'Заочная'])
    .setRequired(true);

  // =====================================================================
  // РАЗДЕЛ 1. ШКАЛА ТРОМСО (ТСИС)
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('РАЗДЕЛ 1. ШКАЛА СОЦИАЛЬНОГО ИНТЕЛЛЕКТА ТРОМСО (ТСИС)');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'Оцените, насколько вы согласны с каждым утверждением, используя шкалу от 1 до 7:\n\n' +
      '1 — Полностью согласен\n' +
      '2 — Согласен\n' +
      '3 — Наверное, согласен\n' +
      '4 — Не знаю\n' +
      '5 — Наверное, не согласен\n' +
      '6 — Не согласен\n' +
      '7 — Полностью не согласен'
    );

  var tsisItems = [
    'Я могу предсказывать поведение других людей.',
    'Я часто чувствую, что мне трудно понять выбор других людей.',
    'Я знаю, что будут чувствовать другие люди после моих действий.',
    'Я легко приспосабливаюсь к разным социальным ситуациям.',
    'Другие люди сердятся на меня, не будучи способными объяснить мне почему.',
    'Я понимаю желания других людей.',
    'Я способен быстро осваиваться в новых ситуациях и сразу знакомиться с людьми.',
    'Люди часто сердятся или раздражаются, когда я говорю то, что я думаю.',
    'Мне трудно налаживать отношения с другими людьми.',
    'Чтобы хорошо понять других людей, мне нужно много времени.',
    'Я могу предсказать, как другие будут реагировать на моё поведение.',
    'Я хорошо подбираю нужные слова в разговоре с новыми людьми.',
    'Я часто могу понять, что на самом деле другие хотят выразить с помощью слов, жестов, мимики и других средств.',
    'Мне часто трудно найти подходящие темы для разговора.',
    'Я часто бываю удивлён реакциями других на то, что я делаю.'
  ];

  for (var i = 0; i < tsisItems.length; i++) {
    form.addScaleItem()
      .setTitle((i + 1) + '. ' + tsisItems[i])
      .setBounds(1, 7)
      .setLabels('Полностью согласен', 'Полностью не согласен')
      .setRequired(true);
  }

  // =====================================================================
  // РАЗДЕЛ 2. ШКАЛА ЛИБОВИЦА (LSAS)
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('РАЗДЕЛ 2. ШКАЛА СОЦИАЛЬНОЙ ТРЕВОЖНОСТИ ЛИБОВИЦА (LSAS)');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'Для каждой из 24 ситуаций оцените:\n' +
      '(а) насколько вам страшно или тревожно в этой ситуации\n' +
      '(б) как часто вы избегаете этой ситуации\n\n' +
      'Шкала СТРАХА:\n' +
      'Страх и тревога отсутствуют · Лёгкий уровень · Средний уровень · Сильный страх или тревога\n\n' +
      'Шкала ИЗБЕГАНИЯ:\n' +
      'Никогда · Редко · Часто · Всегда'
    );

  var lsasSituations = [
    'Говорить по телефону в общественных местах',
    'Участвовать в деятельности небольшой группы',
    'Есть в общественных местах',
    'Пить в общественных местах',
    'Говорить с вышестоящим лицом',
    'Выступать перед публикой',
    'Идти в гости',
    'Работать, когда за мной наблюдают',
    'Писать, когда за мной наблюдают',
    'Звонить малознакомому человеку',
    'Говорить с глазу на глаз с малознакомым человеком',
    'Встречаться с незнакомыми людьми',
    'Справлять нужду в общественном туалете',
    'Входить в комнату, где уже сидят другие люди',
    'Находиться в центре внимания',
    'Высказываться на собрании без предварительной подготовки',
    'Проходить тест, сдавать экзамен',
    'Высказывать своё неодобрение и несогласие малознакомому человеку',
    'Смотреть прямо в глаза малознакомому человеку',
    'Выступать с подготовленной речью перед группой людей',
    'Пытаться завести романтическое знакомство',
    'Возвращать товар в магазин',
    'Приглашать гостей',
    'Не поддаваться уговорам продавца, делая покупки'
  ];

  var fearOpts  = ['Страх и тревога отсутствуют', 'Лёгкий уровень', 'Средний уровень', 'Сильный страх или тревога'];
  var avoidOpts = ['Никогда', 'Редко', 'Часто', 'Всегда'];

  for (var j = 0; j < lsasSituations.length; j++) {
    var n = j + 1;
    form.addMultipleChoiceItem()
      .setTitle('Ситуация ' + n + '. ' + lsasSituations[j] + '  —  насколько вам СТРАШНО или ТРЕВОЖНО?')
      .setChoiceValues(fearOpts)
      .setRequired(true);
    form.addMultipleChoiceItem()
      .setTitle('Ситуация ' + n + '. ' + lsasSituations[j] + '  —  как часто вы ИЗБЕГАЕТЕ этой ситуации?')
      .setChoiceValues(avoidOpts)
      .setRequired(true);
  }

  // =====================================================================
  // РАЗДЕЛ 3. ОПРОСНИК ОСТиСФ
  // =====================================================================
  form.addPageBreakItem()
    .setTitle('РАЗДЕЛ 3. ОПРОСНИК СОЦИАЛЬНОЙ ТРЕВОГИ И СОЦИОФОБИИ (ОСТиСФ)');

  form.addSectionHeaderItem()
    .setTitle('Инструкция')
    .setHelpText(
      'Оцените, насколько каждое утверждение соответствует вам.\n\n' +
      '1 — Нет\n2 — Скорее, нет\n3 — Скорее, да\n4 — Да'
    );

  var ostisfItems = [
    'Бывает ли, что, встречаясь с незнакомыми людьми, вы испытываете беспокойство и волнение, так как не знаете, как себя вести?',
    'Бывает ли так, что вы хотите пойти на праздник в гости, но остаётесь дома, потому что стесняетесь чего-то, волнуетесь и не можете преодолеть это чувство?',
    'Трудно ли вам, разговаривая с коллегами по работе (учёбе), смотреть им прямо в глаза?',
    'Верно ли, что вы с трудом заводите новые знакомства?',
    'Думаете ли вы, что другие могут обсуждать ваше «неловкое поведение» или «недостатки» после общения с вами?',
    'Стараетесь ли вы скрыть признаки волнения (дрожание рук, голоса, потение ладоней и др.) в ситуации выступления перед аудиторией?',
    'Когда вы испытываете симпатию (или влюбляетесь), то не говорите об этом объекту своих чувств, боясь отвержения?',
    'Вы скорее промолчите, нежели станете отстаивать свою точку зрения в спорной ситуации?',
    'Вы считаете, что окружающие вас негативно оценивают и отвергают в общении?',
    'Бывает ли так, что, даже при тщательной подготовке к проверке знаний (экзамену, аттестации), волнение не уменьшается, а, наоборот, усиливается при приближении этого события?',
    'Бывает ли, что вы смущаетесь (краснеете, опускаете глаза), если с вами заговорил человек противоположного пола?',
    'Чувствуете ли вы себя неловко, если вам приходится отказать в просьбе знакомому?',
    'Верно ли, что вы скорее предпочтёте самостоятельно искать нужный вам адрес, чем обратитесь за помощью к прохожему, даже если спешите?',
    'Оформление документов для вас мучительно и вы стараетесь этого избегать, так как это требует инициативы в общении с незнакомыми людьми?',
    'Трудно ли вам выполнять задание (какую-либо работу), если за вами кто-то наблюдает?',
    'Верно ли, что вам хотелось бы преодолеть нерешительность в общении с некоторыми интересными людьми?',
    'Бывает ли так, что в компании вы ведёте себя нарочито свободно, стараясь скрыть своё волнение (смущение)?',
    'Бывает ли так: осознавая, что вряд ли ваш знакомый откажет вам в просьбе одолжить книгу на пару дней, тем не менее вы не решаетесь попросить его об этом?',
    'Ваш голос звучит не так уверенно, как хотелось бы (дрожит, пропадает), если приходится выступать перед незнакомой аудиторией?',
    'Если вам необходимо позвонить по телефону незнакомому человеку, вы долго настраиваетесь, но, несмотря на это, волнуетесь при разговоре?',
    'Бывает ли, что у вас учащается сердцебиение и/или возникает ком в горле от одной мысли, что завтра вам придётся беседовать с начальником о проделанной работе?',
    'Испытываете ли вы неловкость, если человек противоположного пола уделяет вам знаки внимания?',
    'Бывает ли так, что вы стесняетесь примерять одежду перед покупкой?',
    'Стараетесь ли вы оттянуть на какое-то время (или избежать) участие в ситуации оценивания ваших знаний и умений?',
    'Трудно ли вам проявить инициативу, знакомясь с человеком противоположного пола?',
    'После сдачи экзамена (или аттестации, др.), вы продолжаете мысленно возвращаться к тому, как это было?',
    'В беседе с начальником вам с трудом удаётся не выдать признаки волнения и тревоги?',
    'Вы предпочтёте потерять деньги и не станете возвращать некачественный продукт в магазин из-за опасений критики или недовольства в свой адрес?',
    'Иногда, находясь в кафе или столовой, вы испытываете неловкость и дискомфорт, так как боитесь, что в глазах окружающих вы выглядите «как-то не так» (хуже, чем обычно)?'
  ];

  var ostisfOpts = ['1 — Нет', '2 — Скорее, нет', '3 — Скорее, да', '4 — Да'];

  for (var k = 0; k < ostisfItems.length; k++) {
    form.addMultipleChoiceItem()
      .setTitle((k + 1) + '. ' + ostisfItems[k])
      .setChoiceValues(ostisfOpts)
      .setRequired(true);
  }

  // =====================================================================
  // ФИНАЛЬНОЕ СООБЩЕНИЕ И ССЫЛКИ
  // =====================================================================
  form.setConfirmationMessage('Спасибо за участие! Ваши ответы внесли важный вклад в исследование.');

  Logger.log('=== ФОРМА СОЗДАНА ===');
  Logger.log('Редактирование: ' + form.getEditUrl());
  Logger.log('Для респондентов: ' + form.getPublishedUrl());
}
